<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OrlandoUp</RootNamespace>
    <AssemblyName>OrlandoUp.Web</AssemblyName>
    <UserSecretsId>3210a9d5-f709-4a87-a796-c49bb7af6fbb</UserSecretsId>
  </PropertyGroup>

  <!-- Every version is explicit (Docs/decisions.md D2/01 of the leva 01 spec): a floating
       range would let a restore on another machine bring a different tree than the one
       measured here. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
  </ItemGroup>

  <!-- The test host needs to reach the entry point type of this assembly, which top-level
       statements declare as internal. -->
  <ItemGroup>
    <InternalsVisibleTo Include="OrlandoUp.Tests" />
  </ItemGroup>

  <!-- The generator meta tag of the layout has to prove that the page in front of you came from
       THIS working tree, which is what the visual check of the leva asks for. The short commit
       hash alone cannot prove it: during the check the content commit does not exist yet. So the
       stamp carries the marker for an uncommitted tree as well, and that marker IS the proof of a
       fresh build - it can only appear on a build made from a tree with pending changes.
       No package and no source-link: two git calls, and an empty stamp when git is not there. -->
  <Target Name="StampBuildRevision" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" ContinueOnError="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="BuildGitHash" />
      <Output TaskParameter="ExitCode" PropertyName="BuildGitHashExitCode" />
    </Exec>
    <Exec Command="git status --porcelain" ConsoleToMSBuild="true" ContinueOnError="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="BuildGitStatus" />
      <Output TaskParameter="ExitCode" PropertyName="BuildGitStatusExitCode" />
    </Exec>
    <PropertyGroup>
      <SourceRevisionId Condition="'$(BuildGitHashExitCode)' == '0' and '$(BuildGitHash)' != ''">$(BuildGitHash)</SourceRevisionId>
      <SourceRevisionId Condition="'$(SourceRevisionId)' != '' and '$(BuildGitStatus)' != ''">$(SourceRevisionId)+dirty</SourceRevisionId>
    </PropertyGroup>
  </Target>

</Project>
