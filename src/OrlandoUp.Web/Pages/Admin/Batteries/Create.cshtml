@page "/admin/batteries/create"
@model OrlandoUp.Pages.Admin.Batteries.CreateModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = L["Admin_BatteryCreateTitle"].Value;
}

<section class="section">
    <div class="page">
        <h1>@L["Admin_BatteryCreateTitle"]</h1>

        @if (Model.Problem is not null)
        {
            <p class="error-summary" role="alert">@Model.Problem</p>
        }

        <form method="post">
            <div class="field">
                <label for="assetTag">@L["Admin_FieldAssetTag"]</label>
                <input id="assetTag" name="AssetTag" type="text" maxlength="40" value="@Model.AssetTag"
                       aria-describedby="tag-help" required />
                <p class="field__help" id="tag-help">@L["Admin_FieldBatteryTagHelp"]</p>
            </div>

            <div class="field">
                <label for="productId">@L["Admin_FieldProduct"]</label>
                <select id="productId" name="ProductId" aria-describedby="product-help">
                    @foreach (Product product in Model.Scooters)
                    {
                        <option value="@product.Id" selected="@(product.Id == Model.ProductId)">@product.Slug</option>
                    }
                </select>
                <p class="field__help" id="product-help">@L["Admin_FieldBatteryProductHelp"]</p>
            </div>

            <div class="field">
                <label for="kind">@L["Admin_FieldBatteryKind"]</label>
                <select id="kind" name="Kind" aria-describedby="kind-help">
                    @foreach (BatteryKind kind in Enum.GetValues<BatteryKind>())
                    {
                        <option value="@kind" selected="@(kind == Model.Kind)">@L[$"Admin_BatteryKind{kind}"]</option>
                    }
                </select>
                <p class="field__help" id="kind-help">@L["Admin_FieldBatteryKindHelp"]</p>
            </div>

            <div class="field">
                <label for="rangeMiles">@L["Admin_FieldBatteryRange"]</label>
                <input id="rangeMiles" name="RangeMiles" type="number" step="0.1" value="@Model.RangeMiles"
                       aria-describedby="range-help" />
                <p class="field__help" id="range-help">@L["Admin_FieldBatteryRangeHelp"]</p>
            </div>

            <div class="field">
                <label for="status">@L["Admin_FieldStatus"]</label>
                <select id="status" name="Status">
                    @foreach (UnitStatus status in Enum.GetValues<UnitStatus>())
                    {
                        <option value="@status" selected="@(status == Model.Status)">@L[$"Admin_Status{status}"]</option>
                    }
                </select>
            </div>

            <div class="field">
                <label for="serialNumber">@L["Admin_FieldSerial"]</label>
                <input id="serialNumber" name="SerialNumber" type="text" maxlength="80"
                       value="@Model.SerialNumber" />
            </div>

            <div class="field">
                <label for="purchasedOn">@L["Admin_FieldPurchasedOn"]</label>
                <input id="purchasedOn" name="PurchasedOn" type="date"
                       value="@(Model.PurchasedOn is DateOnly bought ? bought.ToString("yyyy-MM-dd") : string.Empty)" />
            </div>

            <div class="field">
                <label for="notes">@L["Admin_FieldNotes"]</label>
                <textarea id="notes" name="Notes" rows="4">@Model.Notes</textarea>
            </div>

            <button type="submit" class="button button--primary">@L["Admin_Save"]</button>
            <a class="button button--quiet" asp-page="/Admin/Batteries/Index">@L["Admin_Cancel"]</a>
        </form>
    </div>
</section>
