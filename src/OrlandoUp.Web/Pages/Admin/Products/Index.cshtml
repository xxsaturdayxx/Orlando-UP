@page "/admin/products"
@model OrlandoUp.Pages.Admin.Products.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = L["Admin_ProductsTitle"].Value;
}

<section class="section">
    <div class="page">
        <h1>@L["Admin_ProductsTitle"]</h1>

        <p><a class="button button--primary" asp-page="/Admin/Products/Create">@L["Admin_NewProduct"]</a></p>

        <div class="table-scroll">
            <table>
                <thead>
                    <tr>
                        <th scope="col">@L["Admin_ColSlug"]</th>
                        <th scope="col">@L["Admin_ColCategory"]</th>
                        <th scope="col">@L["Admin_ColNameEnglish"]</th>
                        <th scope="col">@L["Admin_ColNamePortuguese"]</th>
                        <th scope="col">@L["Admin_ColActive"]</th>
                        <th scope="col">@L["Admin_ColUnits"]</th>
                        <th scope="col">@L["Admin_ColAction"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td>@row.Slug</td>
                            <td>@L[CategoryArt.NameKey(row.Category)]</td>
                            <td>
                                @if (row.NameEnglish is null)
                                {
                                    <em class="todo">@L["Admin_MissingTranslation"]</em>
                                }
                                else
                                {
                                    @row.NameEnglish
                                }
                            </td>
                            <td>
                                @if (row.NamePortuguese is null)
                                {
                                    <em class="todo">@L["Admin_MissingTranslation"]</em>
                                }
                                else
                                {
                                    @row.NamePortuguese
                                }
                            </td>
                            <td>@(row.IsActive ? L["Admin_Yes"] : L["Admin_No"])</td>
                            <td>@row.UnitCount</td>
                            <td><a asp-page="/Admin/Products/Edit" asp-route-id="@row.Id">@L["Admin_Edit"]</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
