@page "/terms"
@{
    ViewData["Title"] = L["Terms_Title"].Value;
}

<section class="section">
    <div class="page prose">
        <div class="notice notice--draft">
            <strong>@L["Draft_Banner"]</strong>
        </div>
        <h1>@L["Terms_Title"]</h1>
        <p>@L["Terms_Body"]</p>
    </div>
</section>
