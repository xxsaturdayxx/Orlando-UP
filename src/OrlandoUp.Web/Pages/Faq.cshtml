@page "/faq"
@model FaqModel
@{
    ViewData["Title"] = L["Faq_Title"].Value;
    ViewData["MetaDescription"] = L["Faq_MetaDescription"].Value;
}

<section class="section">
    <div class="page prose">
        <h1>@L["Faq_Title"]</h1>

        @* The list of questions comes from the resource file, not from a bound written here. *@
        @foreach (int number in Model.Numbers)
        {
            <h2>@L["Faq_Q" + number]</h2>
            <p>@L["Faq_A" + number]</p>
        }
    </div>
</section>
