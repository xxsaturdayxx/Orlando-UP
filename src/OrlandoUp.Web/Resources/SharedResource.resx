  <data name="HowItWorks_Title" xml:space="preserve">
    <value>How it works</value>
  </data>
  <data name="HowItWorks_MetaDescription" xml:space="preserve">
    <value>Four steps from booking to pick-up, and how the hand-over works at the Disney and Universal resorts.</value>
  </data>
  <data name="HowItWorks_Intro" xml:space="preserve">
    <value>Delivery and pick-up are part of the rental. Here is what happens on each day of your stay.</value>
  </data>
  <data name="HowItWorks_MeetTitle" xml:space="preserve">
